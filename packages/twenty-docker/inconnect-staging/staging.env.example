# STAGING-S0. Plantilla vacía. El despliegue futuro requiere valores y autorización.
# Referencias completas con versión y digest verificados para la plataforma de la VM.
STAGING_POSTGRES_IMAGE=
STAGING_REDIS_IMAGE=
STAGING_INCONNECT_IMAGE=

# Entradas de secretos Compose de staging. Nunca exportarlas desde otro entorno.
STAGING_PG_BOOTSTRAP_PASSWORD=
# Contenido del archivo ACL, con saltos de línea reales. Ver el documento.
STAGING_REDIS_ACL=

# Configuración futura de Twenty. Este bloque queda sin conectar al Compose en S0.
# PG_DATABASE_URL=
# PG_DATABASE_REPLICA_URL se omite. No hay réplica propuesta.
# REDIS_URL=
# REDIS_QUEUE_URL se omite. Usará REDIS_URL en el diseño de instancia única.
# APP_SECRET=
# ENCRYPTION_KEY=
# NODE_ENV=production
# NODE_PORT=3000
# SERVER_URL=http://127.0.0.1:3000
# IS_MULTIWORKSPACE_ENABLED=false
# STORAGE_TYPE=local
# STORAGE_LOCAL_PATH=.local-storage
# DISABLE_DB_MIGRATIONS=true
# DISABLE_CRON_JOBS_REGISTRATION=true
# IS_FDW_ENABLED=false
# IS_BILLING_ENABLED=false
# TELEMETRY_ENABLED=false
# MARKETPLACE_CATALOG_SYNC_CRON_ENABLED=false
# EMAIL_DRIVER=LOGGER
# EMAILING_DOMAIN_DRIVER=LOG
# IS_EMAIL_VERIFICATION_REQUIRED=false
# AUTH_GOOGLE_ENABLED=false
# AUTH_MICROSOFT_ENABLED=false
# MESSAGING_PROVIDER_GMAIL_ENABLED=false
# MESSAGING_PROVIDER_MICROSOFT_ENABLED=false
# CALENDAR_PROVIDER_GOOGLE_ENABLED=false
# CALENDAR_PROVIDER_MICROSOFT_ENABLED=false
